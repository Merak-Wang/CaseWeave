{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrieval-agent.invalid/schema/workspace.schema.json",
  "title": "CaseWeave workspace capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageScope",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "packageScope": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directory",
          "name",
          "kind",
          "capability"
        ],
        "properties": {
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

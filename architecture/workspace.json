{
  "$schema": "./workspace.schema.json",
  "schemaVersion": 1,
  "packageScope": "@retrieval-agent/",
  "forbiddenGenericPackageNames": ["core", "common", "shared", "utils"],
  "maxModuleLines": 500,
  "testConvention": {
    "packagePattern": "packages/<package>/src/<name>.spec.ts",
    "repositoryIntegrationRoot": "tests"
  },
  "protocolConvention": {
    "fileName": "protocol.ts",
    "allowedExportedTypeSuffixes": ["Params", "Response", "Notification"]
  },
  "packages": [
    {
      "directory": "contracts",
      "name": "@retrieval-agent/contracts",
      "kind": "definition",
      "capability": "跨进程与跨层共享的领域类型、事件和 Provider 端口；不含实现策略。",
      "allowedInternalDependencies": [],
      "maxSourceLines": 1050
    },
    {
      "directory": "query-understanding",
      "name": "@retrieval-agent/query-understanding",
      "kind": "query-compiler",
      "capability": "把 direct-user 文本确定性编译为目标、检索文本、数量策略、类型化过滤和显式歧义；不调用模型或 Provider。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts"],
      "maxSourceLines": 250
    },
    {
      "directory": "retrieval-policy",
      "name": "@retrieval-agent/retrieval-policy",
      "kind": "domain-policy",
      "capability": "验证结构化知识评估并导出唯一下一动作；从不可变观测重建可修订 active ranking。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts"],
      "maxSourceLines": 400
    },
    {
      "directory": "ticket-collection",
      "name": "@retrieval-agent/ticket-collection",
      "kind": "terminal-projection",
      "capability": "从已停止领域状态确定性投影唯一 TicketResultCollection；不选择候选或生成自然语言。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts"],
      "maxSourceLines": 100
    },
    {
      "directory": "domain",
      "name": "@retrieval-agent/domain",
      "kind": "domain",
      "capability": "确定性检索控制器、状态重放、查询收敛与证据上下文策略。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts", "@retrieval-agent/retrieval-policy"],
      "maxSourceLines": 1150
    },
    {
      "directory": "model-service-client",
      "name": "@retrieval-agent/model-service-client",
      "kind": "model-client",
      "capability": "本地模型数据面的版本化 HTTP 协议、握手、超时、取消、背压错误与响应校验。",
      "allowedInternalDependencies": [],
      "maxSourceLines": 650
    },
    {
      "directory": "retrieval-ranking",
      "name": "@retrieval-agent/retrieval-ranking",
      "kind": "retrieval-algorithm",
      "capability": "BM25F、稠密向量、加权 RRF、向量缓存和可选重排；不读取来源或执行授权。",
      "allowedInternalDependencies": ["@retrieval-agent/model-service-client"],
      "maxSourceLines": 1500
    },
    {
      "directory": "provider-local",
      "name": "@retrieval-agent/provider-local",
      "kind": "provider",
      "capability": "开发期只读 Provider、来源适配、动态字段目录、受控 raw 读取与确定性检索。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts", "@retrieval-agent/retrieval-ranking"],
      "maxSourceLines": 950
    },
    {
      "directory": "provider-streamcluster",
      "name": "@retrieval-agent/provider-streamcluster",
      "kind": "provider",
      "capability": "版本化 StreamCluster 只读 HTTP 契约、远端授权传递、超时取消与结构化错误映射。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts"],
      "maxSourceLines": 1050
    },
    {
      "directory": "product-api",
      "name": "@retrieval-agent/product-api",
      "kind": "host-api",
      "capability": "可信 Host/BFF 的详情读取、候选导出、审计与线协议。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts"],
      "maxSourceLines": 700
    },
    {
      "directory": "ui-ticket-results",
      "name": "@retrieval-agent/ui-ticket-results",
      "kind": "ui",
      "capability": "从持久化事件投影可折叠候选集合，通过 Product API 按需读取已重新授权的详情，并注册 DSH 客户端 renderer。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts", "@retrieval-agent/product-api", "@retrieval-agent/ticket-collection"],
      "maxSourceLines": 1050
    },
    {
      "directory": "ui-product-shell",
      "name": "@retrieval-agent/ui-product-shell",
      "kind": "ui-shell",
      "capability": "保留原生 DSH 外壳，仅通过公共 slot 提供会话头工单导出入口。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts", "@retrieval-agent/product-api"],
      "maxSourceLines": 750
    },
    {
      "directory": "product-host",
      "name": "@retrieval-agent/product-host",
      "kind": "host-adapter",
      "capability": "把 Product API 绑定到 DSH Web/Session，恢复可信主体并处理同源导出请求。",
      "allowedInternalDependencies": [
        "@retrieval-agent/contracts",
        "@retrieval-agent/product-api",
        "@retrieval-agent/agent-plugin"
      ],
      "maxSourceLines": 650
    },
    {
      "directory": "dsh-compat",
      "name": "@retrieval-agent/dsh-compat",
      "kind": "compatibility",
      "capability": "锁定 DSH 0.1.1-rc.2 的唯一兼容边界、版本握手和退出断言。",
      "allowedInternalDependencies": ["@retrieval-agent/contracts"],
      "maxSourceLines": 500
    },
    {
      "directory": "agent-plugin",
      "name": "@retrieval-agent/agent-plugin",
      "kind": "application",
      "capability": "DSH 工具、提示词、Session 事件与领域控制器编排；不拥有 Provider 算法。",
      "allowedInternalDependencies": [
        "@retrieval-agent/contracts",
        "@retrieval-agent/domain",
        "@retrieval-agent/dsh-compat",
        "@retrieval-agent/query-understanding",
        "@retrieval-agent/ticket-collection"
      ],
      "maxSourceLines": 1500
    },
    {
      "directory": "bundle",
      "name": "@retrieval-agent/bundle",
      "kind": "composition",
      "capability": "固定产品 preset、Cordis patch、默认 Provider 与发布闭包装配；不含业务策略。",
      "allowedInternalDependencies": [
        "@retrieval-agent/contracts",
        "@retrieval-agent/domain",
        "@retrieval-agent/model-service-client",
        "@retrieval-agent/query-understanding",
        "@retrieval-agent/retrieval-ranking",
        "@retrieval-agent/retrieval-policy",
        "@retrieval-agent/ticket-collection",
        "@retrieval-agent/provider-local",
        "@retrieval-agent/provider-streamcluster",
        "@retrieval-agent/product-api",
        "@retrieval-agent/product-host",
        "@retrieval-agent/ui-ticket-results",
        "@retrieval-agent/ui-product-shell",
        "@retrieval-agent/dsh-compat",
        "@retrieval-agent/agent-plugin"
      ],
      "maxSourceLines": 600
    }
  ]
}

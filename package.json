{
  "name": "@retrieval-agent/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build": "pnpm clean:build && pnpm -r --if-present run build",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck && tsc -p tsconfig.tests.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "browser:fixture": "vite tests/browser --host 127.0.0.1",
    "graph:workspace": "node scripts/workspace-contracts.mjs --write",
    "verify:workspace": "node scripts/workspace-contracts.mjs --check",
    "verify:release": "node scripts/verify-release-closure.mjs",
    "verify:product-quality": "node scripts/verify-product-quality.mjs",
    "verify:release-ready": "pnpm verify && pnpm verify:product-quality",
    "verify:install": "pnpm build && node scripts/verify-clean-install.mjs",
    "verify": "pnpm verify:workspace && pnpm typecheck && pnpm test && pnpm verify:release",
    "verify:all": "pnpm verify && pnpm eval:self-test && pnpm model:test && pnpm verify:install",
    "eval:self-test": "uv run --project python/evals pytest python/evals/tests",
    "model:serve": "uv run --project python/model-service --group runtime retrieval-agent-model-service --manifest architecture/model-manifest.json --embedding-path models/Qwen3-Embedding-0.6B",
    "model:serve:rerank": "uv run --project python/model-service --group runtime retrieval-agent-model-service --manifest architecture/model-manifest.json --embedding-path models/Qwen3-Embedding-0.6B --reranker-path models/Qwen3-Reranker-0.6B --enable-reranker",
    "model:test": "uv run --project python/model-service --group dev pytest python/model-service/tests",
    "model:smoke": "node scripts/verify-real-model.mjs",
    "model:smoke:rerank": "node scripts/verify-real-model.mjs --reranker",
    "model:probe": "node scripts/probe-model-service.mjs",
    "model:eval": "node scripts/evaluate-real-retrieval.mjs",
    "eval:bronze-audit": "node scripts/audit-legacy-bronze.mjs",
    "index:prepare": "pnpm build && node scripts/prepare-development-index.mjs",
    "app:serve": "pnpm build && node scripts/serve-clean-app.mjs"
  },
  "devDependencies": {
    "@retrieval-agent/bundle": "workspace:*",
    "@retrieval-agent/contracts": "workspace:*",
    "@retrieval-agent/domain": "workspace:*",
    "@retrieval-agent/model-service-client": "workspace:*",
    "@retrieval-agent/provider-local": "workspace:*",
    "@retrieval-agent/provider-streamcluster": "workspace:*",
    "@retrieval-agent/product-api": "workspace:*",
    "@retrieval-agent/product-host": "workspace:*",
    "@retrieval-agent/query-understanding": "workspace:*",
    "@retrieval-agent/retrieval-ranking": "workspace:*",
    "@retrieval-agent/retrieval-policy": "workspace:*",
    "@retrieval-agent/ticket-collection": "workspace:*",
    "@retrieval-agent/ui-ticket-results": "workspace:*",
    "@retrieval-agent/ui-product-shell": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "tsdown": "0.22.2",
    "vite": "8.2.2",
    "vitest": "4.1.8"
  }
}

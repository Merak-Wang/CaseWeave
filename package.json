{
  "name": "@retrieval-agent/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build": "pnpm build:code",
    "build:code": "pnpm clean:build && pnpm -r --if-present run build",
    "typecheck": "pnpm build && pnpm typecheck:code",
    "typecheck:code": "pnpm -r --if-present run typecheck && tsc -p tsconfig.tests.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "browser:fixture": "vite tests/browser --host 127.0.0.1",
    "graph:workspace": "node scripts/workspace-contracts.mjs --write",
    "verify:workspace": "node scripts/workspace-contracts.mjs --check",
    "verify:release": "node scripts/verify-release-closure.mjs",
    "verify:install": "node scripts/verify-clean-install.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "pnpm verify:workspace && pnpm typecheck && pnpm test",
    "verify:all": "pnpm verify && pnpm eval:self-test && pnpm model:test && pnpm verify:release && pnpm verify:install",
    "eval:self-test": "uv run --project python/evals pytest python/evals/tests",
    "model:serve": "pnpm models:sync && uv run --project python/model-service --group runtime retrieval-agent-model-service --manifest architecture/model-manifest.json --embedding-path models/Qwen3-Embedding-0.6B --spacy-path models/zh_core_web_sm-3.8.0 --domain-lexicon config/query-domain-lexicon.json --vector-cache-dir .cache/retrieval-agent-vectors",
    "model:serve:rerank": "node scripts/retrieval-agent.mjs models --role reranker && uv run --project python/model-service --group runtime retrieval-agent-model-service --manifest architecture/model-manifest.json --embedding-path models/Qwen3-Embedding-0.6B --spacy-path models/zh_core_web_sm-3.8.0 --domain-lexicon config/query-domain-lexicon.json --vector-cache-dir .cache/retrieval-agent-vectors --reranker-path models/Qwen3-Reranker-0.6B --enable-reranker",
    "model:test": "uv run --frozen --project python/model-service --group runtime --group dev pytest python/model-service/tests",
    "model:container": "node scripts/model-container.mjs",
    "model:smoke": "node scripts/verify-real-model.mjs",
    "model:smoke:rerank": "node scripts/verify-real-model.mjs --reranker",
    "model:probe": "node scripts/probe-model-service.mjs",
    "model:eval": "node scripts/evaluate-real-retrieval.mjs",
    "eval:bronze-audit": "node scripts/audit-legacy-bronze.mjs",
    "data:download": "node scripts/manage-ticket-data.mjs download",
    "data:build": "node scripts/manage-ticket-data.mjs build",
    "data:verify": "node scripts/manage-ticket-data.mjs verify",
    "data:sync": "node scripts/manage-ticket-data.mjs all",
    "index:prepare": "node scripts/prepare-development-index.mjs",
    "db:up": "docker compose -f config/database/compose.yml up -d",
    "db:prepare": "node scripts/database.mjs prepare",
    "db:verify": "node scripts/database.mjs verify",
    "db:status": "node scripts/database.mjs status",
    "start:database": "node scripts/database-web.mjs",
    "retrieval-agent": "node scripts/retrieval-agent.mjs",
    "models:sync": "node scripts/retrieval-agent.mjs models",
    "start": "node scripts/retrieval-agent.mjs web",
    "app:setup": "node scripts/retrieval-agent.mjs setup",
    "app:serve": "node scripts/retrieval-agent.mjs web",
    "accept:task": "node scripts/accept-user-task.mjs"
  },
  "devDependencies": {
    "@retrieval-agent/bundle": "workspace:*",
    "@retrieval-agent/contracts": "workspace:*",
    "@retrieval-agent/domain": "workspace:*",
    "@retrieval-agent/model-service-client": "workspace:*",
    "@retrieval-agent/product-api": "workspace:*",
    "@retrieval-agent/product-host": "workspace:*",
    "@retrieval-agent/provider-database": "workspace:*",
    "@retrieval-agent/provider-local": "workspace:*",
    "@retrieval-agent/provider-streamcluster": "workspace:*",
    "@retrieval-agent/query-understanding": "workspace:*",
    "@retrieval-agent/retrieval-ranking": "workspace:*",
    "@retrieval-agent/ui-ticket-results": "workspace:*",
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "4.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.8",
    "yaml": "2.9.0"
  }
}

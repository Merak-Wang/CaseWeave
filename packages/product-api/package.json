{
  "name": "@retrieval-agent/product-api",
  "version": "0.1.0",
  "description": "Trusted-host detail and allowlisted CSV export application service",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./presentation": {
      "types": "./lib/presentation.d.ts",
      "default": "./lib/presentation.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@retrieval-agent/contracts": "workspace:*",
    "@retrieval-agent/ticket-collection": "workspace:*"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT"
}

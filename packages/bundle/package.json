{
  "name": "@retrieval-agent/bundle",
  "version": "0.1.0",
  "description": "Installable DSH bundle and fixed Retrieval Agent preset",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./session-compat": {
      "types": "./lib/session-compat.d.ts",
      "default": "./lib/session-compat.js"
    },
    "./opencode-pi-ai": {
      "types": "./lib/opencode-pi-ai.d.ts",
      "default": "./lib/opencode-pi-ai.js"
    },
    "./provider": {
      "types": "./lib/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./streamcluster-provider": {
      "types": "./lib/streamcluster-provider.d.ts",
      "default": "./lib/streamcluster-provider.js"
    },
    "./principal": {
      "types": "./lib/principal.d.ts",
      "default": "./lib/principal.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets",
    "README.md"
  ],
  "bin": {
    "retrieval-agent-install": "./lib/install-cli.js",
    "retrieval-agent-uninstall": "./lib/uninstall-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@retrieval-agent/agent-plugin": "workspace:*",
    "@retrieval-agent/contracts": "workspace:*",
    "@retrieval-agent/domain": "workspace:*",
    "@retrieval-agent/dsh-compat": "workspace:*",
    "@retrieval-agent/model-service-client": "workspace:*",
    "@retrieval-agent/provider-local": "workspace:*",
    "@retrieval-agent/provider-database": "workspace:*",
    "@retrieval-agent/provider-streamcluster": "workspace:*",
    "@retrieval-agent/product-api": "workspace:*",
    "@retrieval-agent/product-host": "workspace:*",
    "@retrieval-agent/query-understanding": "workspace:*",
    "@retrieval-agent/retrieval-ranking": "workspace:*",
    "@retrieval-agent/ui-ticket-results": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

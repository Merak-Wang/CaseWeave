# 复制为 .env 后填写；.env 和实际凭据由 .gitignore 排除，不要提交。
# 也可直接运行 setup.cmd（Windows）或 bash setup.sh，由向导创建并填写。
# Docker Compose reads these paths on Windows and Linux with the same separator.
COMPOSE_PROJECT_NAME=retrieval-agent
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=config/database/compose.yml;config/model-service/compose.yml;config/app/compose.yml
# NVIDIA GPU: append ;config/model-service/compose.gpu.yml to COMPOSE_FILE.
RETRIEVAL_AGENT_WEB_PORT=3080
RETRIEVAL_AGENT_MODEL_PORT=8012
RETRIEVAL_AGENT_MYSQL_PORT=13306
RETRIEVAL_AGENT_MILVUS_PORT=19530
RETRIEVAL_AGENT_MILVUS_HEALTH_PORT=9091
# 主 Agent 模型服务，与容器下载的本地 Qwen embedding 模型分开配置。
# 容器部署需同时填写下面四项，值应与实际模型服务及其 DSH Provider 一致。
# 容器仅公开 /retrieval；DSH 管理界面与设置页保留在容器内部。
RETRIEVAL_AGENT_BROWSER_LLM_PROVIDER=
RETRIEVAL_AGENT_BROWSER_LLM_MODEL=
RETRIEVAL_AGENT_BROWSER_LLM_BASE_URL=
RETRIEVAL_AGENT_BROWSER_LLM_API_KEY_ENV=
# 上面的 API_KEY_ENV 填 RETRIEVAL_AGENT_MAIN_MODEL_API_KEY，下面填实际密钥。
RETRIEVAL_AGENT_MAIN_MODEL_API_KEY=
RETRIEVAL_AGENT_BROWSER_LLM_REASONING=off
RETRIEVAL_AGENT_WIKI_LEARNING=1
